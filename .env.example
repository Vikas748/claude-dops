# ==========================================
# DOPS Surgery Management - Environment Configuration
# ==========================================

# 1. Supabase PostgreSQL Database (Required)
# From Supabase Settings -> Database -> Connection Pooling (port 6543)
SUPABASE_DATABASE_URL="postgres://postgres.xxxx:your_password@aws-0-ap-south-1.pooler.supabase.com:6543/postgres"

# 2. Security & Encryption (Required)
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET="your-48-byte-base64url-auth-secret"
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
DATA_ENCRYPTION_KEY="your-32-byte-base64-encryption-key"
# Any secret random string (at least 16 chars)
CRON_SECRET="your-cron-secret-key"

# 3. Bootstrap First Administrator (Required)
DOPS_BOOTSTRAP_ADMIN_EMAIL="doctor-or-admin@hospital.com"

# 4. Email OTP Delivery - SMTP (Required)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_USER="department.burnplastic@gmail.com"
SMTP_PASS="16-character-google-app-password"
MAIL_FROM="DOPS Surgery <department.burnplastic@gmail.com>"

# ------------------------------------------------------------------------------
# 5. STORAGE PROVIDER SELECTION:
# ------------------------------------------------------------------------------
# OPTION A: Cloudflare R2 (10 GB Free, S3-Compatible)
# If these R2 variables are set, all OT images, discharge cards & PDFs automatically
# go to Cloudflare R2!
R2_ACCOUNT_ID="your_cloudflare_account_id"
R2_ACCESS_KEY_ID="your_r2_access_key_id"
R2_SECRET_ACCESS_KEY="your_r2_secret_access_key"
R2_BUCKET_NAME="dops-private"

# OPTION B: Supabase Storage (1 GB Free)
# (Used automatically if Cloudflare R2 variables are not provided)
NEXT_PUBLIC_SUPABASE_URL="https://xxxx.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"
SUPABASE_STORAGE_BUCKET="dops-private"
